# a session with a server of two tools, the client written as lines: the
# handshake, ping, the list of tools, a tool with a text and one with a
# structured result, a tool that fails, and what is no request. The
# server reads one pipe and writes another; each line it sends is
# printed after the line it answers.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/num.aiw"
use "lib/std/json.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
use "lib/async/io.aiw"
use "src/mcp.aiw"
const pipe2 293
buf server 80
buf tools 144
buf to 8
buf from 8
buf rb 65536
buf big 4194400

# echo: the text of the argument "text", or a failure without one
async fn echo x p n r
	call jsonget p n "text" as v vn k
	if k!=5
		call mcpfail r "text is to be a string"
		ret 0
	end
	call mcptext r "you said: "
	call jsonstr r v vn
	ret 0
end
# add: the sum of the numbers a and b, structured, after a wait
async fn add x p n r
	call jsonget p n "a" as v vn k
	call numint v vn as a ok
	call jsonget p n "b" as v vn k
	call numint v vn as b ok2
	await asyncsleep 5
	if x==2
		# a result that is no object
		call byadd r+24 "[1]"
		ret 0
	end
	call byadd r+24 "{\"sum\":\n  "
	call jsonaddi r+24 a+b+x
	call byadd r+24 "\n}"
	ret 0
end
fn say p n
	call print "> "
	call print p n
	call print "\n"
	load4 to+4 as w
	call asyncwriteall w p n as h
	await h as r
	call asyncwriteall w "\n" as h
	await h as r
end
# print the one line the server sends
fn hear
	load4 from as f
	call asyncread f rb 65536 as h
	call asynctimeout h 300 as h
	await h as r
	ifslt r 0
		call print "< nothing\n"
	else
		call print "< "
		call print rb r
	end
end
fn ask p n
	call say p n
	call hear
end
store server "demo"
store server+8 4
store server+16 "1.2.3"
store server+24 5
store server+32 "Two tools, to try the server."
store server+40 29
store server+48 tools
store server+56 2
store server+64 0
store tools "echo"
store tools+8 4
store tools+16 "Say it back"
store tools+24 11
data inecho "{\"type\":\"object\",\n \"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
len inecho as n
store tools+32 inecho
store tools+40 n
ref echo as f
store tools+64 f
store tools+72 "add"
store tools+80 3
store tools+88 "Add two whole numbers"
store tools+96 21
data inadd "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}}}"
len inadd as n
store tools+104 inadd
store tools+112 n
data outadd "{\"type\":\"object\",\"properties\":{\"sum\":{\"type\":\"integer\"}}}"
len outadd as n
store tools+120 outadd
store tools+128 n
ref add as f
store tools+136 f
sys pipe2 to 0x80000
sys pipe2 from 0x80000
load4 to as rd
load4 from+4 as wr
call mcpserve server rd wr as sv
call ask "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"t\",\"version\":\"0\"}}}"
call say "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":\"p-1\",\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"text\":\"ol\\u00e1 \\\"mundo\\\"\\n\"}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"add\",\"arguments\":{\"a\":40,\"b\":2}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\"}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"none\",\"arguments\":{}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/call\",\"params\":{\"name\":\"add\",\"arguments\":[1,2]}}"
store server+64 2
call ask "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",\"params\":{\"name\":\"add\",\"arguments\":{\"a\":1,\"b\":1}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"resources/list\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\"}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"1999-01-01\"}}"
call ask "this is no JSON"
call ask "[1,2]"
call ask "{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":13}"
call ask "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":3}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}"
call ask "{\"id\":20,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"1.0\",\"id\":21,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":2.0,\"id\":22,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"text\":\"x\"}}}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":1.5,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":1e2,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":-7,\"method\":\"ping\"}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":23,\"method\":\"tools/list\",\"params\":7}"
call ask "{\"jsonrpc\":\"2.0\",\"id\":24,\"method\":\"initialize\",\"params\":false}"
call ask "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\",\"params\":7}"
# a line of exactly the 4 MiB it may have is read, and is no JSON; one
# byte more is too long, whether or not its line feed comes with it
i=0
while i<4194305
	storeb big+i 120
	i+=1
end
call print "> 4194304 bytes x\n"
load4 to+4 as w
call asyncwriteall w big 4194304 as h
await h as r
call asyncwriteall w "\n" as h
await h as r
call hear
call print "> 4194305 bytes x\n"
storeb big+4194305 10
call asyncwriteall w big 4194306 as h
await h as r
call hear
call ask "{\"jsonrpc\":\"2.0\",\"id\":30,\"method\":\"ping\"}"
call say "   "
call say "{\"jsonrpc\":\"2.0\",\"id\":14,\"method\":\"ping\"}"
call hear
# the input ends in a line without a line feed
load4 to+4 as w
call asyncwriteall w "{\"jsonrpc\":\"2.0\",\"id\":15,\"method\":\"ping\"}" as h
await h as r
call asyncclose w
call print "> the same with the id 15, and the end\n"
call hear
await sv as r
call print "the server ended with "
call putn r
load server+72 as r
call print ", initialized "
call putn r
call print "\n"
