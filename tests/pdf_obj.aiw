call get "<</A 1" "A"
call get "<</A 1" "B"
call get "<<>>" ""
call get "<</ 5>>" ""
call print "# the elements of an array\n"
call arr "[1 /a (s) [2 3] <</k 1>> 4 0 R]"
call arr "[]"
call arr "[ ]"
call arr "[1 ("
call arr "1"
call arr "[1 2"
