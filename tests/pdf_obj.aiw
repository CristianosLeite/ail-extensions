call ref "12\x0a%c\x0a0\x09R"
call ref "/a 0 R"
call print "# the bytes of a string\n"
call str "(abc)"
call str "(a\x5cn\x5cr\x5ct\x5cb\x5cf\x5c(\x5c)\x5c\x5c)"
