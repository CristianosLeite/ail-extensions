call val "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
call val "null"
call val "/N 1"
call val "(s)(t)"
call val "<41>"
call val "1.5]"
call val "endobj"
call print "# the value of a key\n"
call get "<</Type /Page /Kids [1 0 R 2 0 R] /Count 2 /A#42 (x) /Sub <</Type /X>> /R 7 0 R>>" "Type"
call get "<</Type /Page /Kids [1 0 R 2 0 R] /Count 2 /A#42 (x) /Sub <</Type /X>> /R 7 0 R>>" "Kids"
call get "<</Type /Page /Kids [1 0 R 2 0 R] /Count 2 /A#42 (x) /Sub <</Type /X>> /R 7 0 R>>" "Count"
call get "<</Type /Page /Kids [1 0 R 2 0 R] /Count 2 /A#42 (x) /Sub <</Type /X>> /R 7 0 R>>" "AB"
call get "<</Type /Page /Kids [1 0 R 2 0 R] /Count 2 /A#42 (x) /Sub <</Type /X>> /R 7 0 R>>" "Sub"
