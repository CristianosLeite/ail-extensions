# pdf/src/pdfdoc.aiw: files written for the test by Python 3, which
# also wrote what each line is to print: a table of one section and of
# two, with an object replaced and one given up, a section that names
# itself, bytes before the header, entries that point to nothing, a
# circle of references, an encrypted file, seventeen files that are no
# PDF, and the work and the memory used to the last unit.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "pdf/src/pdfdoc.aiw"
buf d pdfdocsize
fn num v
	ifslt v 0
		call print "-"
		v=0-v
	end
	call putn v
end
fn open p n w m
	call pdfdocopen p n d w m as r
	call print "open "
	call num r
	call print "\n"
end
# the value at a, as it is written
fn text a e
	ifz a
		call print "none\n"
		ret 0
	end
	call pdfobjvalue a e as m
	ifz m
		call print "?\n"
		ret 0
	end
	call print a m-a
	call print "\n"
end
fn show n
	call putn n
	call print ": "
	call pdfdocobj d n as a e
	call text a e
end
fn key n kp kn
	call putn n
	call print "."
	call print kp kn
	call print ": "
	call pdfdocobj d n as a e
	ifz a
		call print "none\n"
		ret 0
	end
	call pdfdocget d a e kp kn as v ve
	call text v ve
end
fn deref n
	call putn n
	call print " -> "
	call pdfdocobj d n as a e
	ifz a
		call print "none\n"
		ret 0
	end
	call pdfdocderef d a e as v ve
	call text v ve
end
fn err
	call pdfdocerr d as r
	call print "err "
	call num r
	call print "\n"
end
call print "# a table of one section\n"
call open "%PDF-1.4\x0a1 0 obj\x0a<</Type /Catalog /Pages 2 0 R>>\x0aendobj\x0a2 0 obj\x0a<</Type /Pages /Kids [] /Count 0>>\x0aendobj\x0a3 0 obj\x0a(a string)\x0aendobj\x0a4 0 obj\x0a3 0 R\x0aendobj\x0axref\x0a0 5\x0a0000000000 65535 f \x0a0000000009 00000 n \x0a0000000056 00000 n \x0a0000000106 00000 n \x0a0000000132 00000 n \x0atrailer\x0a<</Size 5 /Root 1 0 R>>\x0astartxref\x0a153\x0a%%EOF\x0a" 100000 1000000
call show 0
call show 1
call show 2
call show 3
call show 4
call show 5
call show 8388609
call key 1 "Pages"
call key 1 "Type"
call key 1 "None"
call key 3 "Type"
call deref 4
