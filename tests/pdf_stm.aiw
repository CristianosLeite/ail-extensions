# pdf/src/pdfstm.aiw, and the cross reference streams and object
# streams of pdf/src/pdfdoc.aiw: files written for the test by Python
# 3, which packed the streams with its zlib and its base64 and wrote
# the rows of the predictors, and which also wrote what each line is
# to print: the bytes it packed. A stream is unpacked to the end of a
# buffer that has a byte "<"; after a failure the buffer is that byte.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "pdf/src/pdfdoc.aiw"
use "pdf/src/pdfstm.aiw"
buf d pdfdocsize
buf out 24
data hexd "0123456789abcdef"
fn num v
	ifslt v 0
		call print "-"
		v=0-v
	end
	call putn v
end
fn open p n w m
	call pdfdocopen p n d w m as r
	call print "open "
	call num r
	call print "\n"
end
fn text a e
	ifz a
		call print "none\n"
		ret 0
	end
	call pdfobjvalue a e as m
	ifz m
		call print "?\n"
		ret 0
	end
	call print a m-a
	call print "\n"
end
fn show n
	call putn n
	call print ": "
	call pdfdocobj d n as a e
	call text a e
end
fn deref n
	call putn n
	call print " -> "
	call pdfdocobj d n as a e
	ifz a
		call print "none\n"
		ret 0
	end
	call pdfdocderef d a e as v ve
	call text v ve
end
fn err
	call pdfdocerr d as r
	call print "err "
	call num r
	call print "\n"
end
# the stream n unpacked: the result and the buffer, as text if every
# byte of it is one that prints, else in hexadecimal after "x:"
fn data n
	call putn n
	call print ": "
	call bycut out 0
	call byaddb out 60
	call pdfdocobj d n as a e
	call pdfstmdata d a e out as r
	call num r
	call print " "
	load out as p
	load out+8 as m
	h=0
	i=1
	while i<m
		loadb p+i as c
		if (c<32)|(c>126)
			h=1
		end
		i+=1
	end
	ifz h
		call print p m
	else
		call print "<x:"
		i=1
		while i<m
			loadb p+i as c
			call print hexd+(c>>4) 1
			call print hexd+(c&15) 1
			i+=1
		end
	end
	call print "\n"
end
# the result and the number of bytes only
fn size n
	call putn n
	call print ": "
	call bycut out 0
	call pdfdocobj d n as a e
	call pdfstmdata d a e out as r
	call num r
	call print " "
	load out+8 as m
	call putn m
	call print "\n"
end
fn raw n
	call putn n
	call print ": raw "
	call pdfdocobj d n as a e
	call pdfstmraw d a e as p m
	if p
		call putn m
	else
		call print "none"
	end
	call print "\n"
end
