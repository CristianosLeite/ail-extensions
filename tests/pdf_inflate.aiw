# pdf/src/inflate.aiw: DEFLATE data of each kind of block, made by zlib
# of Python 3 or written bit by bit, unpacked to the end of a buffer that
# has a byte "<" already; the number of bytes read and the bytes added,
# or their number and a hash of them where they are many; then what is
# not such data, each start of three streams among it, and a stream of
# zlib with its sum. After a failure the buffer is the one byte.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "pdf/src/inflate.aiw"
buf out 24
# a number with its sign
fn num v
	ifslt v 0
		call print "-"
		v=0-v
	end
	call putn v
end
# the result r and the buffer: as it is, or the number of bytes after
# its first and their hash (FNV-1a, 64 bits)
fn done r show
	call num r
	call print " "
	load out as p
	load out+8 as n
	if show
		call print p n
	else
		call putn n-1
		call print " "
		h=0xcbf29ce484222325
		i=1
		while i<n
			loadb p+i as c
			h=(h^c)*0x100000001b3
			i+=1
		end
		call putn h
	end
	call print "\n"
end
fn raw p n max show
	call bycut out 0
	call byaddb out 60
	call inflate p n out max as r
	call done r show
end
fn zl p n max
	call bycut out 0
	call byaddb out 60
	call inflatezlib p n out max as r
	call done r 1
end
# how many of the starts of the n bytes at p, each shorter than they,
# are refused with the buffer as it was
fn starts p n
	k=0
	i=0
	while i<n
		call bycut out 0
		call byaddb out 60
		call inflate p i out 100000 as r
		load out+8 as m
		if (r==inflatebad)&(m==1)
			k+=1
		end
		i+=1
	end
	call putn k
	call print " of "
	call putn n
	call print "\n"
end
