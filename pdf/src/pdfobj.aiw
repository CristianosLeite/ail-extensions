# pdf/src/pdfobj.aiw -- the syntax of the objects of a PDF file (ISO
# 32000-1, 7.2 and 7.3), read where the bytes lie: white space and
# comments, a token, the end of a whole value, the value of a key of a
# dictionary, the elements of an array, a number, a name as its bytes
# and the bytes of a string. A program that uses it uses lib/std/bytes.aiw first.
#
# Bytes are two addresses, that of the first and that after the last,
# here a and e; nothing is read at e or after it and nothing is written
# but the buffer that pdfobjstring is given. No function fails: what is not
# there or not well formed is a result, and every function ends for
# every bytes, in a time that grows with their number.
#
# A value is a number, a name, a string, an array, a dictionary, one of
# the words true, false and null, or a reference, the three tokens
# "12 0 R". A stream is a dictionary with bytes after it, which
# pdf/src/pdfstm.aiw reads.
#
# Every name of this file starts with "pdfobj"; a program has no var of
# such a name (see lib/std/io.aiw).

# the kinds of a token
const pdfobjend 0            # no token: the bytes are at their end
const pdfobjint 1            # 12, -3, +7
const pdfobjreal 2           # 1.5, -.25, 4.
const pdfobjname 3           # /Name
const pdfobjstr 4            # (a string)
const pdfobjhex 5            # <48656c6c6f>
const pdfobjarr 6            # [
const pdfobjarrend 7         # ]
const pdfobjdict 8           # <<
const pdfobjdictend 9        # >>
const pdfobjword 10          # any other run of bytes: true, obj, R, Tj, { and }
const pdfobjbad 11           # a string without its end, a ")" or a ">" alone

# the deepest that arrays and dictionaries may lie in one another
const pdfobjdeep 256

# 1 if the byte pdfobjc is white space
fn pdfobjwhite pdfobjc
	ret (pdfobjc==32)|(pdfobjc==10)|(pdfobjc==13)|(pdfobjc==9)|(pdfobjc==12)|(pdfobjc==0)
end

# 1 if the byte pdfobjc ends a name, a number or a word
fn pdfobjdelim pdfobjc
	if (pdfobjc==32)|(pdfobjc==10)|(pdfobjc==13)|(pdfobjc==9)|(pdfobjc==12)|(pdfobjc==0)
		ret 1
	end
	if (pdfobjc==40)|(pdfobjc==41)|(pdfobjc==60)|(pdfobjc==62)|(pdfobjc==91)|(pdfobjc==93)
		ret 1
	end
	ret (pdfobjc==123)|(pdfobjc==125)|(pdfobjc==47)|(pdfobjc==37)
end

# the address of the first byte from pdfobja on that is no white space and
# in no comment, or pdfobje
fn pdfobjskip pdfobja pdfobje
	label more
	if pdfobja<pdfobje
		loadb pdfobja as pdfobjc
		call pdfobjwhite pdfobjc as pdfobjw
		if pdfobjw
			pdfobja+=1
			jmp more
		end
		if pdfobjc==37
			label line
			pdfobja+=1
			if pdfobja<pdfobje
				loadb pdfobja as pdfobjc
				if (pdfobjc!=10)&(pdfobjc!=13)
					jmp line
				end
			end
			jmp more
		end
	end
	ret pdfobja
end

# the value of the hexadecimal digit pdfobjc, or 16 if it is none
fn pdfobjdigit pdfobjc
	if (pdfobjc>=48)&(pdfobjc<=57)
		ret pdfobjc-48
	end
	pdfobjc|=32
	if (pdfobjc>=97)&(pdfobjc<=102)
		ret pdfobjc-87
	end
	ret 16
end

# The token that starts at pdfobja, which is the address of a byte that is
# no white space (pdfobjskip gives it): its kind and the address after it.
fn pdfobjtok pdfobja pdfobje
	if pdfobja>=pdfobje
		ret pdfobjend pdfobje
	end
	loadb pdfobja as pdfobjc
	pdfobji=pdfobja+1
	if pdfobjc==47
		label name
		if pdfobji<pdfobje
			loadb pdfobji as pdfobjc
			call pdfobjdelim pdfobjc as pdfobjw
			ifz pdfobjw
				pdfobji+=1
				jmp name
			end
		end
		ret pdfobjname pdfobji
	end
	if pdfobjc==40
		# parentheses in pairs belong to the string, and so does
		# whatever follows a backslash
		pdfobjk=1
		label str
		if pdfobji>=pdfobje
			ret pdfobjbad pdfobje
		end
		loadb pdfobji as pdfobjc
		pdfobji+=1
		if pdfobjc==92
			pdfobji+=1
			jmp str
		end
		if pdfobjc==40
			pdfobjk+=1
		end
		if pdfobjc==41
			pdfobjk-=1
			ifz pdfobjk
				if pdfobji>pdfobje
					ret pdfobjbad pdfobje
				end
				ret pdfobjstr pdfobji
			end
		end
		jmp str
	end
	if pdfobjc==60
		if pdfobji<pdfobje
			loadb pdfobji as pdfobjc
			if pdfobjc==60
				ret pdfobjdict pdfobji+1
			end
		end
		label hex
		if pdfobji>=pdfobje
			ret pdfobjbad pdfobje
		end
		loadb pdfobji as pdfobjc
		pdfobji+=1
		if pdfobjc==62
			ret pdfobjhex pdfobji
		end
		call pdfobjdigit pdfobjc as pdfobjk
		call pdfobjwhite pdfobjc as pdfobjw
		if (pdfobjk==16)&(pdfobjw==0)
			ret pdfobjbad pdfobji
		end
		jmp hex
	end
	if pdfobjc==62
		if pdfobji<pdfobje
			loadb pdfobji as pdfobjc
			if pdfobjc==62
				ret pdfobjdictend pdfobji+1
			end
		end
		ret pdfobjbad pdfobji
	end
	if pdfobjc==91
		ret pdfobjarr pdfobji
	end
	if pdfobjc==93
		ret pdfobjarrend pdfobji
	end
	if pdfobjc==41
		ret pdfobjbad pdfobji
	end
	if (pdfobjc==123)|(pdfobjc==125)
		ret pdfobjword pdfobji
	end
	# a number has digits, a sign before them at most and one dot at
	# most; any other run of bytes is a word
	pdfobjk=pdfobjint
	pdfobjd=0
	if (pdfobjc==43)|(pdfobjc==45)
		pdfobjc=48
		pdfobjd=0-1
	end
	label run
	if (pdfobjc>=48)&(pdfobjc<=57)
		pdfobjd+=1
	else
		if (pdfobjc==46)&(pdfobjk==pdfobjint)
			pdfobjk=pdfobjreal
		else
			pdfobjk=pdfobjword
		end
	end
	if pdfobji<pdfobje
		loadb pdfobji as pdfobjc
		call pdfobjdelim pdfobjc as pdfobjw
		ifz pdfobjw
			pdfobji+=1
			jmp run
		end
	end
	if (pdfobjk!=pdfobjword)&(pdfobjd==0)
		pdfobjk=pdfobjword
	end
	ret pdfobjk pdfobji
end

# 1 and its two numbers if the value at pdfobja is a reference, "12 0 R";
# else 0
fn pdfobjref pdfobja pdfobje
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjint
		ret 0 0 0
	end
	call pdfobjint pdfobja pdfobje as pdfobjx pdfobjw
	call pdfobjskip pdfobjn pdfobje as pdfobjb
	call pdfobjtok pdfobjb pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjint
		ret 0 0 0
	end
	call pdfobjint pdfobjb pdfobje as pdfobjy pdfobjw
	call pdfobjskip pdfobjn pdfobje as pdfobjb
	call pdfobjtok pdfobjb pdfobje as pdfobjk pdfobjn
	if (pdfobjk!=pdfobjword)|(pdfobjn!=pdfobjb+1)
		ret 0 0 0
	end
	loadb pdfobjb as pdfobjc
	if pdfobjc!=82
		ret 0 0 0
	end
	ret 1 pdfobjx pdfobjy
end

# The address after the value that starts at pdfobja, a byte that is no
# white space: after the "]" or ">>" that closes it if it is an array
# or a dictionary, and after the R if it is a reference. 0 if there is
# no value: the end of the bytes, a token that is pdfobjbad, a "]" or ">>"
# with nothing open, an array or a dictionary that is not closed or
# that lies deeper than pdfobjdeep.
fn pdfobjvalue pdfobja pdfobje
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk==pdfobjint
		call pdfobjskip pdfobjn pdfobje as pdfobjb
		call pdfobjtok pdfobjb pdfobje as pdfobjk pdfobjm
		if pdfobjk==pdfobjint
			call pdfobjskip pdfobjm pdfobje as pdfobjb
			call pdfobjtok pdfobjb pdfobje as pdfobjk pdfobjm
			if (pdfobjk==pdfobjword)&(pdfobjm==pdfobjb+1)
				loadb pdfobjb as pdfobjc
				if pdfobjc==82
					ret pdfobjm
				end
			end
		end
		ret pdfobjn
	end
	if (pdfobjk==pdfobjend)|(pdfobjk==pdfobjbad)|(pdfobjk==pdfobjarrend)|(pdfobjk==pdfobjdictend)
		ret 0
	end
	if (pdfobjk!=pdfobjarr)&(pdfobjk!=pdfobjdict)
		ret pdfobjn
	end
	pdfobjd=1
	label more
	call pdfobjskip pdfobjn pdfobje as pdfobja
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if (pdfobjk==pdfobjend)|(pdfobjk==pdfobjbad)
		ret 0
	end
	if (pdfobjk==pdfobjarr)|(pdfobjk==pdfobjdict)
		pdfobjd+=1
		if pdfobjd>pdfobjdeep
			ret 0
		end
	end
	if (pdfobjk==pdfobjarrend)|(pdfobjk==pdfobjdictend)
		pdfobjd-=1
		ifz pdfobjd
			ret pdfobjn
		end
	end
	jmp more
end

# 1 if the name token at pdfobja, which ends at pdfobjn, is the name of the pdfobjkn
# bytes at pdfobjkp; a "#" and two hexadecimal digits in the token are the
# byte they write
fn pdfobjis pdfobja pdfobjn pdfobjkp pdfobjkn
	pdfobja+=1
	pdfobji=0
	while pdfobja<pdfobjn
		loadb pdfobja as pdfobjc
		pdfobja+=1
		if (pdfobjc==35)&(pdfobja+2<=pdfobjn)
			loadb pdfobja as pdfobjx
			loadb pdfobja+1 as pdfobjy
			call pdfobjdigit pdfobjx as pdfobjx
			call pdfobjdigit pdfobjy as pdfobjy
			if (pdfobjx<16)&(pdfobjy<16)
				pdfobjc=pdfobjx*16+pdfobjy
				pdfobja+=2
			end
		end
		if pdfobji>=pdfobjkn
			ret 0
		end
		loadb pdfobjkp+pdfobji as pdfobjx
		if pdfobjx!=pdfobjc
			ret 0
		end
		pdfobji+=1
	end
	ret pdfobji==pdfobjkn
end

# Write the name of the token from pdfobja to pdfobjn, without its "/" and with
# each "#" and two hexadecimal digits as the byte they write, to the
# pdfobjmax bytes at pdfobjdst: the number of its bytes, or pdfobjmax+1 if they are
# more.
fn pdfobjnamed pdfobja pdfobjn pdfobjdst pdfobjmax
	pdfobja+=1
	pdfobji=0
	while pdfobja<pdfobjn
		loadb pdfobja as pdfobjc
		pdfobja+=1
		if (pdfobjc==35)&(pdfobja+2<=pdfobjn)
			loadb pdfobja as pdfobjx
			loadb pdfobja+1 as pdfobjy
			call pdfobjdigit pdfobjx as pdfobjx
			call pdfobjdigit pdfobjy as pdfobjy
			if (pdfobjx<16)&(pdfobjy<16)
				pdfobjc=pdfobjx*16+pdfobjy
				pdfobja+=2
			end
		end
		if pdfobji>=pdfobjmax
			ret pdfobjmax+1
		end
		storeb pdfobjdst+pdfobji pdfobjc
		pdfobji+=1
	end
	ret pdfobji
end

# The address of the value that the dictionary at pdfobja has for the key
# of the pdfobjkn bytes at pdfobjkp, without the "/": a byte that is no white
# space. 0 if it has no such key, or if the bytes at pdfobja are no
# dictionary or one that is not well formed before the key.
fn pdfobjget pdfobja pdfobje pdfobjkp pdfobjkn
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjdict
		ret 0
	end
	label more
	call pdfobjskip pdfobjn pdfobje as pdfobja
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjname
		ret 0
	end
	call pdfobjskip pdfobjn pdfobje as pdfobjv
	call pdfobjis pdfobja pdfobjn pdfobjkp pdfobjkn as pdfobjw
	if pdfobjw
		call pdfobjtok pdfobjv pdfobje as pdfobjk pdfobjn
		if (pdfobjk==pdfobjend)|(pdfobjk==pdfobjbad)|(pdfobjk==pdfobjdictend)|(pdfobjk==pdfobjarrend)
			ret 0
		end
		ret pdfobjv
	end
	call pdfobjvalue pdfobjv pdfobje as pdfobjn
	jz pdfobjn none
	jmp more
	label none
	ret 0
end

# The address of the first element of the array at pdfobja, or of the "]"
# if it has none; 0 if the bytes at pdfobja are no array. pdfobjnext is the
# address of the element after the one at pdfobja, or of the "]"; 0 if the
# element at pdfobja is no value. An element is at an address where pdfobjtok
# gives no pdfobjarrend.
fn pdfobjfirst pdfobja pdfobje
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjarr
		ret 0
	end
	tail pdfobjskip pdfobjn pdfobje
end
fn pdfobjnext pdfobja pdfobje
	call pdfobjvalue pdfobja pdfobje as pdfobjn
	ifz pdfobjn
		ret 0
	end
	tail pdfobjskip pdfobjn pdfobje
end

# the integer at pdfobja and 1, or 0 and 0 if the token there is no integer
# or has more than 18 digits
fn pdfobjint pdfobja pdfobje
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if pdfobjk!=pdfobjint
		ret 0 0
	end
	loadb pdfobja as pdfobjc
	pdfobjs=0
	if (pdfobjc==43)|(pdfobjc==45)
		pdfobjs=pdfobjc==45
		pdfobja+=1
	end
	if pdfobjn-pdfobja>18
		ret 0 0
	end
	pdfobjv=0
	while pdfobja<pdfobjn
		loadb pdfobja as pdfobjc
		pdfobjv=pdfobjv*10+pdfobjc-48
		pdfobja+=1
	end
	if pdfobjs
		pdfobjv=0-pdfobjv
	end
	ret pdfobjv 1
end

# the number at pdfobja, an integer or a real, in thousandths, rounded
# toward zero, and 1; or 0 and 0 if the token there is no number or has
# more than 15 digits before its dot
fn pdfobjnum pdfobja pdfobje
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	if (pdfobjk!=pdfobjint)&(pdfobjk!=pdfobjreal)
		ret 0 0
	end
	loadb pdfobja as pdfobjc
	pdfobjs=0
	if (pdfobjc==43)|(pdfobjc==45)
		pdfobjs=pdfobjc==45
		pdfobja+=1
	end
	pdfobjv=0
	pdfobjd=0
	label whole
	if pdfobja<pdfobjn
		loadb pdfobja as pdfobjc
		pdfobja+=1
		if pdfobjc!=46
			pdfobjv=pdfobjv*10+pdfobjc-48
			pdfobjd+=1
			jmp whole
		end
	end
	if pdfobjd>15
		ret 0 0
	end
	pdfobjv*=1000
	pdfobjd=100
	while (pdfobja<pdfobjn)&(pdfobjd>0)
		loadb pdfobja as pdfobjc
		pdfobjv+=(pdfobjc-48)*pdfobjd
		pdfobjd/=10
		pdfobja+=1
	end
	if pdfobjs
		pdfobjv=0-pdfobjv
	end
	ret pdfobjv 1
end

# Add the bytes that the string at pdfobja writes, a string in parentheses
# or in hexadecimal digits, to the buffer pdfobjb: 1, or 0 if the token
# there is no string or the kernel has no memory, and then the buffer
# is as it was.
fn pdfobjstring pdfobja pdfobje pdfobjb
	call pdfobjtok pdfobja pdfobje as pdfobjk pdfobjn
	load pdfobjb+8 as pdfobjstart
	if pdfobjk==pdfobjhex
		pdfobja+=1
		pdfobjn-=1
		pdfobjv=0-1
		while pdfobja<pdfobjn
			loadb pdfobja as pdfobjc
			pdfobja+=1
			call pdfobjdigit pdfobjc as pdfobjc
			if pdfobjc<16
				ifslt pdfobjv 0
					pdfobjv=pdfobjc
				else
					call byaddb pdfobjb pdfobjv*16+pdfobjc as pdfobjw
					jz pdfobjw nomem
					pdfobjv=0-1
				end
			end
		end
		ifsge pdfobjv 0
			call byaddb pdfobjb pdfobjv*16 as pdfobjw
			jz pdfobjw nomem
		end
		ret 1
	end
	if pdfobjk!=pdfobjstr
		ret 0
	end
	pdfobja+=1
	pdfobjn-=1
	label more
	if pdfobja>=pdfobjn
		ret 1
	end
	loadb pdfobja as pdfobjc
	pdfobja+=1
	if pdfobjc==13
		# an end of line is a line feed, however it is written
		pdfobjc=10
		if pdfobja<pdfobjn
			loadb pdfobja as pdfobjv
			if pdfobjv==10
				pdfobja+=1
			end
		end
	end
	if (pdfobjc==92)&(pdfobja<pdfobjn)
		loadb pdfobja as pdfobjc
		pdfobja+=1
		if (pdfobjc>=48)&(pdfobjc<=55)
			# one to three digits of an octal number
			pdfobjc-=48
			pdfobjv=2
			label oct
			if (pdfobjv>0)&(pdfobja<pdfobjn)
				loadb pdfobja as pdfobjw
				if (pdfobjw>=48)&(pdfobjw<=55)
					pdfobjc=pdfobjc*8+pdfobjw-48
					pdfobja+=1
					pdfobjv-=1
					jmp oct
				end
			end
			pdfobjc&=255
			jmp add
		end
		if pdfobjc==13
			# a backslash at the end of a line: the string goes on
			if pdfobja<pdfobjn
				loadb pdfobja as pdfobjv
				if pdfobjv==10
					pdfobja+=1
				end
			end
			jmp more
		end
		if pdfobjc==10
			jmp more
		end
		if pdfobjc==110
			pdfobjc=10
		else
			if pdfobjc==114
				pdfobjc=13
			else
				if pdfobjc==116
					pdfobjc=9
				else
					if pdfobjc==98
						pdfobjc=8
					else
						if pdfobjc==102
							pdfobjc=12
						end
					end
				end
			end
		end
	end
	label add
	call byaddb pdfobjb pdfobjc as pdfobjw
	jz pdfobjw nomem
	jmp more
	label nomem
	store pdfobjb+8 pdfobjstart
	ret 0
end
