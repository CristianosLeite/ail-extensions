data 0
data pdffontlig "ff fi fl ffiffl"

# the number that the hexadecimal digits among the pdffontn bytes at pdffontp
# write, white space between them left out, or all ones if a byte is
# neither or the digits are more than eight
fn pdffonthexnum pdffontp pdffontn
	pdffontv=0
	pdffontk=0
	while pdffontn
		loadb pdffontp as pdffontc
		call pdfobjdigit pdffontc as pdffontx
		if pdffontx>15
			call pdfobjwhite pdffontc as pdffontc
			ifz pdffontc
				ret 0-1
			end
		else
			pdffontk+=1
			if pdffontk>8
				ret 0-1
			end
			pdffontv=pdffontv*16+pdffontx
		end
		pdffontp+=1
		pdffontn-=1
	end
	ret pdffontv
end

# the character of the glyph name of the pdffontn bytes at pdffontp, or 0
fn pdffontglyph pdffontp pdffontn
	# a.sc is a
	pdffonti=1
	while pdffonti<pdffontn
		loadb pdffontp+pdffonti as pdffontc
		if pdffontc==46
			pdffontn=pdffonti
		end
		pdffonti+=1
	end
	pdffontq=pdffontnames
	label row
	loadb pdffontq as pdffontc
	if pdffontc
		pdffontl=0
		label len
		loadb pdffontq+pdffontl as pdffontc
		if pdffontc
			pdffontl+=1
			jmp len
		end
		if pdffontl==pdffontn
			pdffonti=0
			label same
			if pdffonti<pdffontn
				loadb pdffontq+pdffonti as pdffontc
				loadb pdffontp+pdffonti as pdffontx
				if pdffontc==pdffontx
					pdffonti+=1
					jmp same
				end
			else
				load2 pdffontq+pdffontl+1 as pdffontc
				ret pdffontc
			end
		end
		pdffontq+=pdffontl+3
		jmp row
	end
	loadb pdffontp as pdffontc
	if pdffontn==1
		ret pdffontc
	end
	if (pdffontn<5)|(pdffontc!=117)
		ret 0
	end
	load2 pdffontp+1 as pdffontc
	if (pdffontc==0x696e)&(pdffontn==7)
		call pdffonthexnum pdffontp+3 4 as pdffontc
	else
		if pdffontn>7
			ret 0
		end
		call pdffonthexnum pdffontp+1 pdffontn-1 as pdffontc
	end
	if pdffontc>0x10ffff
		ret 0
	end
	ret pdffontc
end

# make the entry of the code pdffontcode the value pdffontv
fn pdffontput pdffontr pdffontcode pdffontv
	load pdffontr+8 as pdffontw
	pdffontl=256
	if pdffontw
		pdffontl=65536
	end
	if pdffontcode<pdffontl
		load pdffontr+16 as pdffontm
		store4 pdffontm+pdffontcode*4 pdffontv
	end
end

# add the character pdffontcp to the buffer pdffontb as UTF-8, U+FFFD if it is
# none: 1, or 0
fn pdffontutf8 pdffontb pdffontcp
	# half of a surrogate pair, and what is above the last character,
	# are no characters
	if ((pdffontcp>=0xd800)&(pdffontcp<0xe000))|(pdffontcp>0x10ffff)
		pdffontcp=0xfffd
	end
	if pdffontcp<0x80
		tail byaddb pdffontb pdffontcp
	end
	if pdffontcp<0x800
		call byaddb pdffontb 0xc0|(pdffontcp>>6) as pdffontw
	else
		if pdffontcp<0x10000
			call byaddb pdffontb 0xe0|(pdffontcp>>12) as pdffontw
		else
			call byaddb pdffontb 0xf0|(pdffontcp>>18) as pdffontw
			call byaddb pdffontb 0x80|(pdffontcp>>12&63) as pdffontw
		end
		call byaddb pdffontb 0x80|(pdffontcp>>6&63) as pdffontw
	end
	tail byaddb pdffontb 0x80|(pdffontcp&63)
end

# add the character pdffontcp, or the letters of one of the five ligatures
# U+FB00 to U+FB04, which are written out: 1, or 0
fn pdffontletters pdffontb pdffontcp
	if (pdffontcp>=0xfb00)&(pdffontcp<=0xfb04)
		pdffontcp-=0xfb00
		tail byadd pdffontb pdffontlig+pdffontcp*3 2+(pdffontcp>2)
	end
	tail pdffontutf8 pdffontb pdffontcp
end

fn pdffontnext pdffontr pdffontp pdffontn pdffonti
	load pdffontr+8 as pdffontw
	loadb pdffontp+pdffonti as pdffontc
	pdffonti+=1
	if pdffontw&(pdffonti<pdffontn)
		loadb pdffontp+pdffonti as pdffontx
		pdffontc=pdffontc<<8|pdffontx
		pdffonti+=1
	end
	ret pdffontc pdffonti
end

fn pdffonttext pdffontr pdffontcode pdffontb
	load pdffontr+8 as pdffontw
	pdffontl=256
	if pdffontw
		pdffontl=65536
	end
	pdffontv=0
	if pdffontcode<pdffontl
		load pdffontr+16 as pdffontm
		load4 pdffontm+pdffontcode*4 as pdffontv
	end
	ifz pdffontv
		pdffontv=0xfffd
	end
	if pdffontv&0x80000000
		load pdffontr+32 as pdffontm
		tail byadd pdffontb pdffontm+(pdffontv&0xffffff) pdffontv>>24&127
	end
	tail pdffontletters pdffontb pdffontv
end

# 1 if the code is one byte and stands for a space, the character
# U+0020: what the word spacing of a page is added to, and what a
# reader may leave out when that spacing takes it back
fn pdffontspace pdffontr pdffontcode
	load pdffontr+8 as pdffontw
	if pdffontw|(pdffontcode!=32)
		ret 0
	end
	load pdffontr+16 as pdffontm
	load4 pdffontm+128 as pdffontv
	ret pdffontv==32
end

fn pdffontwidth pdffontr pdffontcode
	load pdffontr+8 as pdffontw
	pdffontl=256
	if pdffontw
		pdffontl=65536
	end
	if pdffontcode>=pdffontl
		ret 0
	end
	load pdffontr+24 as pdffontm
	load2 pdffontm+pdffontcode*2 as pdffontv
	ret pdffontv
end

# The entry for the characters that the string at pdffonta writes in UTF-16,
# the higher byte first, after pdffontadd was added to its last byte, as the
# codes of a run have it; pdffontt is a buffer that it empties and uses. 0 if
# it writes none.
fn pdffontdst pdffontd pdffontr pdffonta pdffonte pdffontt pdffontadd
	# reading it is work each time, and one that is longer than any
	# characters of a code is not read
	call pdfobjtok pdffonta pdffonte as pdffontk pdffontn
	call pdfdocspend pdffontd (pdffontn-pdffonta>>3)+1 as pdffontw
	if (pdffontw==0)|(pdffontn-pdffonta>1026)
		ret 0
	end
	call bycut pdffontt 0
	call pdfobjstring pdffonta pdffonte pdffontt as pdffontw
	ifz pdffontw
		# the token is a string: there was no memory for its bytes
		tail pdfdocfail pdffontd pdfdocmem
	end
	load pdffontt as pdffontp
	load pdffontt+8 as pdffontn
	ifz pdffontn
		ret 0
	end
	loadb pdffontp+pdffontn-1 as pdffontc
	storeb pdffontp+pdffontn-1 pdffontc+pdffontadd
	if pdffontn==1
		loadb pdffontp as pdffontc
		ret pdffontc
	end
	load pdffontr+40 as pdffontoff
	pdffontk=0
	pdffontcp=0
	pdffonti=0
	while pdffonti+1<pdffontn
		loadb pdffontp+pdffonti as pdffontc
		loadb pdffontp+pdffonti+1 as pdffontx
		pdffontc=pdffontc<<8|pdffontx
		pdffonti+=2
		if (pdffontc>=0xd800)&(pdffontc<0xdc00)&(pdffonti+1<pdffontn)
			loadb pdffontp+pdffonti as pdffontx
			loadb pdffontp+pdffonti+1 as pdffonty
			pdffontx=pdffontx<<8|pdffonty
			if (pdffontx>=0xdc00)&(pdffontx<0xe000)
				pdffontc=0x10000+(pdffontc-0xd800<<10)+pdffontx-0xdc00
				pdffonti+=2
			end
		end
		pdffontcp=pdffontc
		pdffontk+=1
		call pdffontletters pdffontr+32 pdffontc as pdffontw
		ifz pdffontw
			store pdffontr+40 pdffontoff
			tail pdfdocfail pdffontd pdfdocmem
		end
	end
	load pdffontr+40 as pdffontn
	pdffontn-=pdffontoff
	# one character needs no bytes
	if (pdffontk<2)|(pdffontn>127)|(pdffontoff>0xffffff)
		store pdffontr+40 pdffontoff
		if pdffontk==1
			ret pdffontcp
		end
		ret 0
	end
	ret 0x80000000|(pdffontn<<24)|pdffontoff
end

# take the codes and their characters from the ToUnicode CMap whose
# stream dictionary is at pdffonta
fn pdffontcmap pdffontd pdffontr pdffonta pdffonte
	local pdffontb 24
	local pdffontt 24
	store pdffontb 0
	store pdffontb+8 0
	store pdffontb+16 0
	store pdffontt 0
	store pdffontt+8 0
	store pdffontt+16 0
	call pdfstmdata pdffontd pdffonta pdffonte pdffontb as pdffontx
	jnz pdffontx done
	load pdffontb as pdffontp
	load pdffontb+8 as pdffonte
	pdffonte+=pdffontp
	pdffontmode=0
	pdffontk=0
	pdffontlo=0
	pdffonthi=0
	label more
	call pdfobjskip pdffontp pdffonte as pdffontp
	call pdfobjtok pdffontp pdffonte as pdffontkind pdffontm
	jz pdffontkind done
	jeq pdffontkind pdfobjbad done
	call pdfdocspend pdffontd 1 as pdffontw
	jz pdffontw done
	if pdffontkind==pdfobjword
		pdffontmode=0
		pdffontk=0
		call pdfdocword pdffontp pdffontm "beginbfchar" as pdffontw
		if pdffontw
			pdffontmode=1
		end
		call pdfdocword pdffontp pdffontm "beginbfrange" as pdffontw
		if pdffontw
			pdffontmode=2
		end
	end
	if (pdffontkind==pdfobjhex)&(pdffontmode!=0)
		if pdffontk==0
			call pdffonthexnum pdffontp+1 pdffontm-pdffontp-2 as pdffontlo
			pdffontk=1
		else
			if (pdffontk==1)&(pdffontmode==2)
				call pdffonthexnum pdffontp+1 pdffontm-pdffontp-2 as pdffonthi
				pdffontk=2
			else
				pdffontk=0
				if pdffontmode==1
					call pdffontdst pdffontd pdffontr pdffontp pdffonte pdffontt 0 as pdffontv
					call pdffontput pdffontr pdffontlo pdffontv
				else
					# the codes of a run have the destination with its
					# last byte counted up, also one of several characters
					if (pdffonthi>=pdffontlo)&(pdffonthi-pdffontlo<65536)
						call pdfdocspend pdffontd (pdffonthi-pdffontlo)*4 as pdffontw
						jz pdffontw done
						pdffontx=0
						while pdffontlo<=pdffonthi
							call pdffontdst pdffontd pdffontr pdffontp pdffonte pdffontt pdffontx as pdffontv
							call pdffontput pdffontr pdffontlo pdffontv
							call pdfdocerr pdffontd as pdffontw
							jnz pdffontw done
							pdffontx+=1
							pdffontlo+=1
						end
					end
				end
			end
		end
	end
	if (pdffontkind==pdfobjarr)&(pdffontmode==2)&(pdffontk==2)
		# a run with the characters of each code written out
		pdffontk=0
		call pdfobjskip pdffontm pdffonte as pdffontq
		label each
		call pdfobjtok pdffontq pdffonte as pdffontkind pdffontx
		if (pdffontkind==pdfobjhex)&(pdffontlo<=pdffonthi)
			call pdffontdst pdffontd pdffontr pdffontq pdffonte pdffontt 0 as pdffontv
			call pdffontput pdffontr pdffontlo pdffontv
			pdffontlo+=1
			call pdfobjskip pdffontx pdffonte as pdffontq
			call pdfdocspend pdffontd 1 as pdffontw
			jnz pdffontw each
		end
		call pdfobjvalue pdffontp pdffonte as pdffontm
		jz pdffontm done
	end
	pdffontp=pdffontm
	jmp more
	label done
	call byfree pdffontb
	call byfree pdffontt
end

# the encoding that the name token from pdffonta to pdffontm names, or pdffontbase
fn pdffontencname pdffonta pdffontm pdffontbase
	call pdfobjis pdffonta pdffontm "WinAnsiEncoding" as pdffontw
	if pdffontw
		ret pdffontwin
	end
	call pdfobjis pdffonta pdffontm "MacRomanEncoding" as pdffontw
	if pdffontw
		ret pdffontmac
	end
	call pdfobjis pdffonta pdffontm "StandardEncoding" as pdffontw
	if pdffontw
		ret pdffontstd
	end
	ret pdffontbase
end

# Take the encoding from the clear part of the Type 1 font program of
# the font whose dictionary is at pdffonta, if it has one that is no
# StandardEncoding: every code is then what the program says, or
# nothing.
fn pdffonttype1 pdffontd pdffontr pdffonta pdffonte
	local pdffontb 24
	store pdffontb 0
	store pdffontb+8 0
	store pdffontb+16 0
	call pdfdocget pdffontd pdffonta pdffonte "FontDescriptor" as pdffontv pdffontve
	jz pdffontv done
	call pdfdocget pdffontd pdffontv pdffontve "FontFile" as pdffontv pdffontve
	jz pdffontv done
	call pdfstmdata pdffontd pdffontv pdffontve pdffontb as pdffontx
	jnz pdffontx done
	load pdffontb as pdffontp
	load pdffontb+8 as pdffonte
	pdffonte+=pdffontp
	call pdfstmfind pdffontp pdffonte "/Encoding" as pdffontp
	jz pdffontp done
	call pdfobjskip pdffontp+9 pdffonte as pdffontp
	call pdfobjtok pdffontp pdffonte as pdffontk pdffontm
	call pdfdocword pdffontp pdffontm "StandardEncoding" as pdffontw
	jnz pdffontw done
	pdffonti=0
	while pdffonti<256
		call pdffontput pdffontr pdffonti 0
		pdffonti+=1
	end
	# "dup 58 /period put", up to the def that ends the array
	pdffonti=0
	label more
	call pdfobjskip pdffontm pdffonte as pdffontp
	call pdfobjtok pdffontp pdffonte as pdffontk pdffontm
	pdffonti+=1
	if (pdffontk==pdfobjend)|(pdffontk==pdfobjbad)|(pdffonti>4096)
		jmp done
	end
	if pdffontk==pdfobjword
		call pdfdocword pdffontp pdffontm "def" as pdffontw
		jnz pdffontw done
		call pdfdocword pdffontp pdffontm "dup" as pdffontw
		if pdffontw
			call pdfobjskip pdffontm pdffonte as pdffontp
			call pdfobjint pdffontp pdffonte as pdffontc pdffontw
			call pdfobjtok pdffontp pdffonte as pdffontk pdffontm
			call pdfobjskip pdffontm pdffonte as pdffontq
			call pdfobjtok pdffontq pdffonte as pdffontk pdffontx
			if pdffontw&(pdffontk==pdfobjname)
				pdffontm=pdffontx
				call pdffontglyph pdffontq+1 pdffontx-pdffontq-1 as pdffontx
				call pdffontput pdffontr pdffontc pdffontx
			end
		end
	end
	jmp more
	label done
	call byfree pdffontb
end

# the codes of a font of one byte: its encoding and its widths
fn pdffontnarrow pdffontd pdffontr pdffonta pdffonte
	local pdffontnm 128
	pdffontbase=pdffontstd
	pdffontown=1
	call pdfdocget pdffontd pdffonta pdffonte "Subtype" as pdffontv pdffontve
	if pdffontv
		call pdfobjtok pdffontv pdffontve as pdffontk pdffontm
		call pdfobjis pdffontv pdffontm "TrueType" as pdffontw
		if pdffontw
			pdffontbase=pdffontwin
			pdffontown=0
		end
	end
	pdffontdf=0
	pdffontdfe=0
	call pdfdocget pdffontd pdffonta pdffonte "Encoding" as pdffontv pdffontve
	if pdffontv
		call pdfobjtok pdffontv pdffontve as pdffontk pdffontm
		if pdffontk==pdfobjname
			call pdffontencname pdffontv pdffontm pdffontbase as pdffontbase
			pdffontown=0
		end
		if pdffontk==pdfobjdict
			call pdfdocget pdffontd pdffontv pdffontve "Differences" as pdffontdf pdffontdfe
			call pdfdocget pdffontd pdffontv pdffontve "BaseEncoding" as pdffontx pdffontxe
			if pdffontx
				call pdfobjtok pdffontx pdffontxe as pdffontk pdffontm
				call pdffontencname pdffontx pdffontm pdffontbase as pdffontbase
				pdffontown=0
			end
		end
	end
	pdffonti=0
	while pdffonti<256
		load2 pdffontbase+pdffonti*2 as pdffontc
		call pdffontput pdffontr pdffonti pdffontc
		pdffonti+=1
	end
	if pdffontown
		call pdffonttype1 pdffontd pdffontr pdffonta pdffonte
	end
	if pdffontdf
		# a number says which code the names after it start at
		call pdfobjfirst pdffontdf pdffontdfe as pdffontq
		pdffonti=0
		label diff
		if pdffontq
			call pdfobjtok pdffontq pdffontdfe as pdffontk pdffontm
			if pdffontk==pdfobjint
				call pdfobjint pdffontq pdffontdfe as pdffonti pdffontw
			end
			if pdffontk==pdfobjname
				# the name as its bytes: /e#61cute is eacute
				call pdfobjnamed pdffontq pdffontm pdffontnm 128 as pdffontc
				if pdffontc<=128
					call pdffontglyph pdffontnm pdffontc as pdffontc
					if pdffontc
						call pdffontput pdffontr pdffonti pdffontc
					end
				end
				pdffonti+=1
			end
			if (pdffontk==pdfobjint)|(pdffontk==pdfobjname)
				call pdfobjskip pdffontm pdffontdfe as pdffontq
				call pdfdocspend pdffontd 1 as pdffontw
				jnz pdffontw diff
			end
		end
	end
	# the widths, from FirstChar on
	load pdffontr+24 as pdffontt
	call pdfdocget pdffontd pdffonta pdffonte "Widths" as pdffontv pdffontve
	pdffontq=0
	if pdffontv
		call pdfobjfirst pdffontv pdffontve as pdffontq
	end
	ifz pdffontq
		pdffontc=500
		call pdfdocget pdffontd pdffonta pdffonte "BaseFont" as pdffontx pdffontxe
		if pdffontx
			call pdfobjtok pdffontx pdffontxe as pdffontk pdffontm
			if pdffontm-pdffontx>=8
				load pdffontx as pdffontk
				if pdffontk==0x72656972756f432f
					pdffontc=600
				end
			end
		end
		pdffonti=0
		while pdffonti<256
			store2 pdffontt+pdffonti*2 pdffontc
			pdffonti+=1
		end
		ret 0
	end
	call pdfstmparm pdffontd pdffonta pdffonte "FirstChar" 0 as pdffonti
	label width
	call pdfobjtok pdffontq pdffontve as pdffontk pdffontm
	if (pdffontk!=pdfobjarrend)&(pdffontk!=pdfobjend)&(pdffontk!=pdfobjbad)&(pdffonti<256)
		call pdfdocderef pdffontd pdffontq pdffontve as pdffontx pdffontxe
		call pdfobjnum pdffontx pdffontxe as pdffontc pdffontw
		pdffontc/=1000
		if pdffontc>65535
			pdffontc=0
		end
		store2 pdffontt+pdffonti*2 pdffontc
		pdffonti+=1
		call pdfobjnext pdffontq pdffontve as pdffontq
		jz pdffontq out
		call pdfdocspend pdffontd 1 as pdffontw
		jnz pdffontw width
	end
	label out
	ret 0
end

# the widths of a font of two bytes, from its descendant
fn pdffontwide pdffontd pdffontr pdffonta pdffonte
	load pdffontr+24 as pdffontt
	pdffontdw=1000
	pdffontq=0
	pdffontqe=0
	call pdfdocget pdffontd pdffonta pdffonte "DescendantFonts" as pdffontv pdffontve
	if pdffontv
		call pdfstmnth pdffontd pdffontv pdffontve 0 as pdffontx pdffontxe
		if pdffontx
			call pdfstmparm pdffontd pdffontx pdffontxe "DW" 1000 as pdffontdw
			call pdfdocget pdffontd pdffontx pdffontxe "W" as pdffontq pdffontqe
		end
	end
	if pdffontdw>65535
		pdffontdw=0
	end
	pdffonti=0
	while pdffonti<65536
		store2 pdffontt+pdffonti*2 pdffontdw
		pdffonti+=1
	end
	ifz pdffontq
		ret 0
	end
	# a code and an array of widths, or two codes and one width
	call pdfobjfirst pdffontq pdffontqe as pdffontq
	label more
	jz pdffontq out
	call pdfobjint pdffontq pdffontqe as pdffontc pdffontw
	jz pdffontw out
	call pdfobjnext pdffontq pdffontqe as pdffontq
	jz pdffontq out
	call pdfdocspend pdffontd 2 as pdffontw
	jz pdffontw out
	call pdfdocderef pdffontd pdffontq pdffontqe as pdffontx pdffontxe
	call pdfobjtok pdffontx pdffontxe as pdffontk pdffontm
	if pdffontk==pdfobjarr
		call pdfobjfirst pdffontx pdffontxe as pdffontx
		label each
		call pdfobjnum pdffontx pdffontxe as pdffontv pdffontw
		if pdffontw
			pdffontv/=1000
			if (pdffontc<65536)&(pdffontv<65536)
				store2 pdffontt+pdffontc*2 pdffontv
			end
			pdffontc+=1
			call pdfobjnext pdffontx pdffontxe as pdffontx
			call pdfdocspend pdffontd 1 as pdffontw
			if pdffontw&(pdffontx!=0)
				jmp each
			end
		end
	else
		call pdfobjint pdffontx pdffontxe as pdffonthi pdffontw
		jz pdffontw out
		call pdfobjnext pdffontq pdffontqe as pdffontq
		jz pdffontq out
		call pdfobjnum pdffontq pdffontqe as pdffontv pdffontw
		pdffontv/=1000
		if (pdffonthi<65536)&(pdffontv<65536)&(pdffonthi>=pdffontc)
			call pdfdocspend pdffontd pdffonthi-pdffontc as pdffontw
			jz pdffontw out
			while pdffontc<=pdffonthi
				store2 pdffontt+pdffontc*2 pdffontv
				pdffontc+=1
			end
		end
	end
	call pdfobjnext pdffontq pdffontqe as pdffontq
	jmp more
	label out
	ret 0
end

fn pdffontmake pdffontd pdffonta pdffonte
	call pdfdocalloc pdffontd pdffontsize as pdffontr
	ifz pdffontr
		ret 0
	end
	store pdffontr pdffonta
	pdffontn=256
	call pdfdocget pdffontd pdffonta pdffonte "Subtype" as pdffontv pdffontve
	if pdffontv
		call pdfobjtok pdffontv pdffontve as pdffontk pdffontm
		call pdfobjis pdffontv pdffontm "Type0" as pdffontw
		if pdffontw
			pdffontn=65536
			store pdffontr+8 1
		end
	end
	call pdfdocalloc pdffontd pdffontn*4 as pdffontm
	store pdffontr+16 pdffontm
	call pdfdocalloc pdffontd pdffontn*2 as pdffontt
	store pdffontr+24 pdffontt
	if (pdffontm==0)|(pdffontt==0)
		call pdffontfree pdffontd pdffontr
		ret 0
	end
	if pdffontn==256
		call pdffontnarrow pdffontd pdffontr pdffonta pdffonte
	else
		call pdffontwide pdffontd pdffontr pdffonta pdffonte
	end
	call pdfdocget pdffontd pdffonta pdffonte "ToUnicode" as pdffontv pdffontve
	if pdffontv
		call pdfobjtok pdffontv pdffontve as pdffontk pdffontm
		if pdffontk==pdfobjdict
			call pdffontcmap pdffontd pdffontr pdffontv pdffontve
		end
	end
	# the characters of the codes that have several are kept with the
	# font, and count
	load pdffontr+48 as pdffontn
	call pdfdochold pdffontd pdffontn as pdffontw
	if pdffontw
		store pdffontr+56 pdffontn
	end
	ret pdffontr
end

fn pdffontfree pdffontd pdffontr
	load pdffontr+8 as pdffontw
	pdffontn=256
	if pdffontw
		pdffontn=65536
	end
	load pdffontr+16 as pdffonta
	call pdfdocrelease pdffontd pdffonta pdffontn*4
	load pdffontr+24 as pdffonta
	call pdfdocrelease pdffontd pdffonta pdffontn*2
	call byfree pdffontr+32
	load pdffontr+56 as pdffonta
	call pdfdocdrop pdffontd pdffonta
	call pdfdocrelease pdffontd pdffontr pdffontsize
end
