# ail-extensions: what makes AIL usable in another program (README.md).
# A program that uses a module written in AIL names this package as a
# dependency and reads a file of it, for the MCP server SDK
#   use "ail-extensions:mcp/src/mcp.aiw"
# The modules for editors are no AIL and have nothing built from here.
# The SDK needs an AIL that has lib/std/json.aiw, lib/std/num.aiw and
# the async library, which came after the version 0.1.0.
name ail-extensions
version 0.1.0
ail 0.1.0
